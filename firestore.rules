rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrapAdmin() {
      return isSignedIn() &&
             request.auth.token.email == 'busawamwenga@gmail.com' &&
             request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        isBootstrapAdmin() ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    function isValidUser(data) {
      return data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 200 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.role in ['user', 'admin'] &&
             data.appVersionCode is int && data.appVersionCode >= 1 &&
             data.isLocked is bool;
    }

    function isValidMovie(data) {
      return data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
             data.description is string && data.description.size() <= 2000 &&
             data.videoUrl is string && data.videoUrl.size() <= 2000 &&
             data.storagePath is string && data.storagePath.size() <= 500 &&
             data.thumbnailUrl is string && data.thumbnailUrl.size() <= 2000 &&
             data.uploadedBy is string && data.uploadedBy.size() >= 1 && data.uploadedBy.size() <= 128 &&
             (!('fileName' in data) || (data.fileName is string && data.fileName.size() <= 255)) &&
             (!('fileSizeBytes' in data) || (data.fileSizeBytes is int && data.fileSizeBytes >= 0)) &&
             (!('durationSeconds' in data) || (data.durationSeconds is int && data.durationSeconds >= 0)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 60)) &&
             (!('isVipOnly' in data) || data.isVipOnly is bool);
    }

    match /users/{userId} {
      // PII Protection: only the owner or an admin can read a profile; only admins can list all users
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      // New accounts default to role 'user'. Bootstrap verified admin can initialize with 'admin'.
      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       isOwner(userId) &&
                       incoming().uid == request.auth.uid &&
                       isValidUser(incoming()) &&
                       (incoming().role == 'user' || isBootstrapAdmin()) &&
                       incoming().isLocked == false &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       incoming().keys().hasAll(['uid', 'email', 'displayName', 'role', 'appVersionCode', 'isLocked', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['uid', 'email', 'displayName', 'role', 'appVersionCode', 'isLocked', 'createdAt', 'updatedAt']);

      // Admins can change user roles ('user' <-> 'admin') and lock/unlock accounts.
      // Regular owners can only update displayName and appVersionCode, never role or isLocked.
      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUser(incoming()) &&
                       incoming().uid == existing().uid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       (
                         (isAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['role', 'isLocked', 'displayName', 'appVersionCode', 'updatedAt'])) ||
                         (isOwner(userId) &&
                          incoming().role == existing().role &&
                          incoming().isLocked == existing().isLocked &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'appVersionCode', 'updatedAt']))
                       );

      allow delete: if isAdmin() && isValidId(userId);
    }

    match /movies/{movieId} {
      // Signed-in users can browse and watch movies
      allow get: if isSignedIn() && isValidId(movieId);
      allow list: if isSignedIn();

      // Only admins can create, update, or delete movies
      allow create: if isSignedIn() &&
                       isValidId(movieId) &&
                       isValidMovie(incoming()) &&
                       isAdmin() &&
                       incoming().uploadedBy == request.auth.uid &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       incoming().keys().hasAll(['title', 'description', 'videoUrl', 'storagePath', 'thumbnailUrl', 'uploadedBy', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['title', 'description', 'videoUrl', 'storagePath', 'thumbnailUrl', 'fileName', 'fileSizeBytes', 'durationSeconds', 'category', 'isVipOnly', 'uploadedBy', 'createdAt', 'updatedAt']);

      allow update: if isSignedIn() &&
                       isValidId(movieId) &&
                       isValidMovie(incoming()) &&
                       isAdmin() &&
                       incoming().uploadedBy == existing().uploadedBy &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'videoUrl', 'storagePath', 'thumbnailUrl', 'fileName', 'fileSizeBytes', 'durationSeconds', 'category', 'isVipOnly', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(movieId);
    }
  }
}
